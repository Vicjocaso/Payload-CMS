# Local SQLite (ignored on Vercel when POSTGRES_URL is set)
DATABASE_URL=file:./payload-demo.db

# Used to encrypt JWT tokens — set a unique value in Vercel
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:43127

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel production (created from Storage in the Vercel dashboard)
# POSTGRES_URL=
# BLOB_READ_WRITE_TOKEN=
