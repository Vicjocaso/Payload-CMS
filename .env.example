# Local SQLite (ignored on Vercel when a Postgres URL is set)
DATABASE_URL=file:./payload-demo.db

# Used to encrypt JWT tokens — set a unique value in Vercel
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:43127

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# --- Vercel production (Project Settings → Environment Variables) ---
# Add these for Production AND Preview, and enable them for Build.
#
# POSTGRES_URL=
#   Neon / Vercel Postgres pooled connection string.
#   If Neon only created DATABASE_URL, paste that same postgres:// value here
#   (or as DATABASE_URL). Do not use the local file: SQLite URL in Vercel.
#
# BLOB_READ_WRITE_TOKEN=
#   From Vercel Blob (Storage → Blob). Needed for the media collection.
#   Paste the token only — no wrapping quotes.
#
# PAYLOAD_SECRET=
#   Long random string. Do not use the local-dev fallback in production.
#
# NEXT_PUBLIC_SERVER_URL=
#   https://<your-project>.vercel.app  (no trailing slash)
